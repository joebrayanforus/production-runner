<svg width="20" height="20" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
  <!-- Robot body (square with ifm orange) -->
  <rect x="6" y="4" width="12" height="12" fill="#ED6B00" stroke="#1a1a1a" stroke-width="1" rx="1"/>

  <!-- Robot head (smaller square) -->
  <rect x="2" y="7" width="6" height="6" fill="#ED6B00" stroke="#1a1a1a" stroke-width="1" rx="1"/>

  <!-- Eyes (sensors) -->
  <circle cx="4" cy="9" r="1" fill="#1a1a1a"/>
  <circle cx="4" cy="11" r="1" fill="#1a1a1a"/>

  <!-- Antenna (direction indicator pointing left) -->
  <line x1="2" y1="10" x2="0" y2="10" stroke="#1a1a1a" stroke-width="2" stroke-linecap="round"/>
  <circle cx="0.5" cy="10" r="0.5" fill="#FFD700"/>

  <!-- Body details (sensor panels) -->
  <rect x="8" y="6" width="2" height="2" fill="#1a1a1a" opacity="0.3"/>
  <rect x="8" y="12" width="2" height="2" fill="#1a1a1a" opacity="0.3"/>
  <rect x="12" y="6" width="2" height="2" fill="#1a1a1a" opacity="0.3"/>
  <rect x="12" y="12" width="2" height="2" fill="#1a1a1a" opacity="0.3"/>

  <!-- Central ifm logo indicator -->
  <circle cx="12" cy="10" r="2" fill="#ffffff" stroke="#1a1a1a" stroke-width="0.5"/>
  <text x="12" y="11" text-anchor="middle" font-family="Arial" font-size="3" fill="#ED6B00" font-weight="bold">ifm</text>
</svg>
